<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Align with dashboard/aspire/Directory.Packages.props. The host owns the
         dependency graph, so pin the transitive versions it resolves. -->
    <PackageVersion Include="Google.Protobuf" Version="3.36.1" />
    <PackageVersion Include="Azure.Core" Version="1.63.0" />
    <PackageVersion Include="Dapper.AOT" Version="1.1.0" />
  </ItemGroup>
</Project>
