<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Apps use .NET 10, the dashboard host uses .NET 11. Build the .NET 11
         asset only when an 11+ SDK is used, so the apps solution still builds
         with the .NET 10 SDK. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <RootNamespace>RaMonitor.Panels</RootNamespace>
    <AssemblyName>RaMonitor.Panels</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>
</Project>
