@page "/logs"
@page "/share"
@layout ResourcesLayout

@using Aspire.Dashboard.Components.Files
@using Aspire.Dashboard.Components.Layout
@using Microsoft.FluentUI.AspNetCore.Components

<PageTitle>@Title</PageTitle>

<div class="page-content-container">
    <AspirePageContentLayout>
        <PageTitleSection>
            <h1 class="page-header">@Title</h1>
        </PageTitleSection>

        <ToolbarSection>
            @if (_preview is null)
            {
                <div class="file-toolbar" role="toolbar" aria-label="Файлы">
                    <button type="button" class="file-button file-icon-button" @onclick="GoRoot" title="В корень (Home)" aria-label="В корень">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Home())" Width="16px" Color="Color.Custom" CustomColor="currentColor" />
                    </button>
                    <button type="button" class="file-button file-icon-button" @onclick="GoUp" disabled="@IsRoot" title="Вверх" aria-label="Вверх">
                        <FluentIcon Value="@(new Icons.Regular.Size16.ArrowUp())" Width="16px" Color="Color.Custom" CustomColor="currentColor" />
                    </button>
                    <span class="file-path" title="@CurrentPath">@CurrentPath</span>
                    <input class="file-mask"
                           @bind="_mask"
                           @bind:event="oninput"
                           @onkeydown="OnMaskKeyDown"
                           @onkeydown:stopPropagation="true"
                           placeholder="*.log;*.txt" />
                    <button type="button" class="file-button file-icon-button" @onclick="ApplyMask" title="Найти" aria-label="Найти">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Search())" Width="16px" Color="Color.Custom" CustomColor="currentColor" />
                    </button>
                    <button type="button" class="file-button file-icon-button" @onclick="ClearMask" title="Очистить" aria-label="Очистить">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Width="16px" Color="Color.Custom" CustomColor="currentColor" />
                    </button>
                </div>
            }
        </ToolbarSection>

        <MainSection>
            <div class="file-browser" tabindex="0" @onkeydown="OnKeyDown">
                @if (_error is not null)
                {
                    <div class="file-error">@_error</div>
                }

                @if (_preview is not null)
                {
                    <section class="file-preview" aria-label="Просмотр файла">
                        <header class="file-preview-toolbar">
                            <button type="button" class="file-button file-icon-button" @onclick="ClosePreview" title="Назад" aria-label="Назад">
                                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowLeft())" Width="16px" Color="Color.Custom" CustomColor="currentColor" />
                            </button>
                            <FluentIcon Value="@GetIcon(_preview.Entry)" Width="16px" Color="Color.Custom" CustomColor="currentColor" />
                            <strong>@_preview.Entry.Name</strong>
                            <a class="file-button file-icon-button" href="@DownloadUrl(_preview.Entry)" title="Скачать" aria-label="Скачать">
                                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowDownload())" Width="16px" Color="Color.Custom" CustomColor="currentColor" />
                            </a>
                        </header>
                        <pre class="file-preview-text" @ref="_previewElement">@_preview.Text</pre>
                    </section>
                }
                else
                {
                <table class="file-table">
                    <thead>
                        <tr>
                            <th class="file-icon-column" aria-label="Иконка"></th>
                            <th>Name</th>
                            <th>Size</th>
                            <th>Type</th>
                            <th>Date Modified</th>
                            <th>view</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in _entries)
                        {
                            <tr class="@(entry.IsDirectory ? "file-row-directory" : "file-row-file")">
                                <td class="file-icon-column">
                                    <FluentIcon Value="@GetIcon(entry)" Width="16px" Color="Color.Custom" CustomColor="currentColor" />
                                </td>
                                <td class="file-name">
                                    @if (entry.IsDirectory)
                                    {
                                        <button type="button" class="file-link file-name-button" @onclick="() => Navigate(entry.RelativePath)">
                                            @entry.Name
                                        </button>
                                    }
                                    else if (IsPreviewable(entry))
                                    {
                                        <button type="button" class="file-link file-name-button" @onclick="() => PreviewAsync(entry)">
                                            @entry.Name
                                        </button>
                                    }
                                    else
                                    {
                                        <span>@entry.Name</span>
                                    }
                                </td>
                                <td class="file-size">@(entry.IsDirectory ? "—" : FormatSize(entry.Size))</td>
                                <td>@entry.Type</td>
                                <td class="file-date">@entry.Modified.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="file-actions">
                                    @if (entry.IsDirectory)
                                    {
                                        <button type="button" class="file-action-icon" @onclick="() => Navigate(entry.RelativePath)" title="Открыть" aria-label="Открыть">
                                            <FluentIcon Value="@(new Icons.Regular.Size16.FolderOpen())" Width="16px" Color="Color.Custom" CustomColor="currentColor" />
                                        </button>
                                    }
                                    else
                                    {
                                        <a class="file-action-icon" href="@DownloadUrl(entry)" title="Скачать" aria-label="Скачать">
                                            <FluentIcon Value="@(new Icons.Regular.Size16.ArrowDownload())" Width="16px" Color="Color.Custom" CustomColor="currentColor" />
                                        </a>
                                        @if (IsPreviewable(entry))
                                        {
                                            <button type="button" class="file-action-icon" @onclick="() => PreviewAsync(entry)" title="Просмотр" aria-label="Просмотр">
                                                <FluentIcon Value="@(new Icons.Regular.Size16.Eye())" Width="16px" Color="Color.Custom" CustomColor="currentColor" />
                                            </button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (_entries.Count == 0 && _error is null)
                {
                    <p class="file-muted">Ничего не найдено по маске «@_appliedMask».</p>
                }
                }
            </div>
        </MainSection>
    </AspirePageContentLayout>
</div>
