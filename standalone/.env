COMPOSE_PROJECT_NAME=otel-demo-standalone

BIND_ADDR=127.0.0.1

# Отдельные порты, чтобы standalone-версию можно было запустить рядом с основной.
GATEWAY_PORT=8090
DASHBOARD_PORT=18988
OTLP_PORT=4327
APP1_PORT=8091
APP2_PORT=8092

DASHBOARD_APP_NAME=РА-Монитор
DASHBOARD_SUPPRESS_UNSECURED=true
APP1_PUBLIC_URL=http://localhost:8091
APP2_PUBLIC_URL=http://localhost:8092
DASHBOARD_LOGS_PATH=/workspace/logs
DASHBOARD_SHARE_PATH=/host-home

ASPIRE_DASHBOARD_IMAGE=ra-monitor-dashboard:17.0.0
